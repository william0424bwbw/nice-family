  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "typescript": "6.0.3",
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
